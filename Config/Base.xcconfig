IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
ENABLE_BITCODE = NO
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
NPV_BUNDLE_PREFIX = org.example.npv
NPV_APP_GROUP = group.$(NPV_BUNDLE_PREFIX)
NPV_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(NPV_BUNDLE_PREFIX).shared
NPV_PROVIDER_BUNDLE_ID = $(NPV_BUNDLE_PREFIX).tunnel
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
// Untracked, developer-owned signing settings. Never put private keys here.
#include? "Local.xcconfig"
